[sub_resource type="Shader" id="Shader_u8t5v"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.4.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_disabled, vertex_lighting;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0, 0.001);

uniform float point_size : hint_range(0.1, 128.0, 0.1);
uniform float specular : hint_range(0.0, 1.0, 0.01);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

uniform float amplitude = 0.05; // Base amplitude of the shake
uniform float speed = 20.0;     // Speed of the primary oscillation
uniform float secondary_speed = 5.0; // Speed of the secondary oscillation

void vertex() {
    // Calculate distance from the center (UV = 0.5, 0.5)
    vec2 uv_center = vec2(0.5, 0.5);
    float dist_from_center = length(UV - uv_center); // Distance from center (0 to ~0.7ish)

    // Scale amplitude: more shake in the center (dist = 0), less at edges (dist > 0)
    float shake_factor = 1.0 - dist_from_center * 2.0; // 1 at center, 0 at edges
    shake_factor = max(shake_factor, 0.0); // Clamp to avoid negative values

    // Apply the shaking along Z-axis, stronger in the center
    float shake = sin(TIME * speed) * cos(TIME * secondary_speed) * amplitude * shake_factor;
    VERTEX.z += shake;

    // Optional: Add slight X/Y movement if desired (commented out in your code)
    VERTEX.x += sin(TIME * speed) * cos(TIME * secondary_speed) * 0.025 * shake_factor;

    // Apply UV scaling/offset (unchanged from your code)
    UV = UV * uv1_scale.xy + uv1_offset.xy;
}
/*
void vertex() {
	// Shading Mode: Per Vertex
	sin(TIME);
    VERTEX.z+=sin(TIME*20.)*cos(TIME*5.)*0.05;
	//VERTEX.x+=sin(TIME*10.)*cos(TIME*2.5)*0.025;
	UV = UV * uv1_scale.xy + uv1_offset.xy;
}*/

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	SPECULAR = specular;

	ALPHA *= albedo.a * albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
}
"

